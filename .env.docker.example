# Used by `docker compose up`. Copy to `.env` in the repo root before
# building — docker-compose.yml reads these directly, and also passes
# most of them through to the Django container as DATABASE_*/etc.
#
# Note the different variable names vs .env.example (DATABASE_NAME vs
# POSTGRES_DB): POSTGRES_* are the exact env vars the official postgres
# image expects to initialize itself, so docker-compose.yml uses those
# names for the db service and maps them to DATABASE_* for the web
# service. If you're running locally without Docker, use .env.example
# instead.

DEBUG=False
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=social_platform
POSTGRES_USER=social_platform
POSTGRES_PASSWORD=change-me
